{
  "$defs": {
    "AdapterBinding": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Adapter Id",
          "type": "string"
        },
        "adapter_version": {
          "minLength": 1,
          "title": "Adapter Version",
          "type": "string"
        },
        "binding_schema_ref": {
          "minLength": 1,
          "title": "Binding Schema Ref",
          "type": "string"
        },
        "configuration": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsaacAdapterConfig"
            },
            {
              "$ref": "#/$defs/OpenUsdAdapterConfig"
            },
            {
              "$ref": "#/$defs/ReplayAdapterConfig"
            }
          ],
          "title": "Configuration"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "subject_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Subject Id",
          "type": "string"
        },
        "target": {
          "enum": [
            "isaac",
            "openusd",
            "replay"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "subject_id",
        "adapter_id",
        "adapter_version",
        "binding_schema_ref",
        "configuration"
      ],
      "title": "AdapterBinding",
      "type": "object"
    },
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "action_endpoint_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Action Endpoint Id",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "capability_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Capability Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "asset_id",
        "capability_ids",
        "action_endpoint_id"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "asset_kind": {
          "minLength": 1,
          "title": "Asset Kind",
          "type": "string"
        },
        "collision": {
          "$ref": "#/$defs/CollisionSpec"
        },
        "geometry": {
          "$ref": "#/$defs/GeometrySpec"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "manipulation_frames": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]{0,127}$": {
              "$ref": "#/$defs/Pose"
            }
          },
          "title": "Manipulation Frames",
          "type": "object"
        },
        "physical_properties": {
          "$ref": "#/$defs/PhysicalProperties"
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "workstation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Workstation Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workstation_id",
        "asset_kind",
        "geometry",
        "pose"
      ],
      "title": "Asset",
      "type": "object"
    },
    "AssetSource": {
      "additionalProperties": false,
      "description": "One external artifact, its digest, its license, and its admission state.",
      "properties": {
        "admission": {
          "enum": [
            "admitted",
            "pending",
            "unlicensed",
            "rejected"
          ],
          "title": "Admission",
          "type": "string"
        },
        "authority_id": {
          "minLength": 1,
          "title": "Authority Id",
          "type": "string"
        },
        "conflict_notes": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Notes",
          "type": "array"
        },
        "conversion_tolerance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion Tolerance"
        },
        "conversion_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversion Tool"
        },
        "derived_from_source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Derived From Source Id"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "license_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Evidence"
        },
        "license_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Ref"
        },
        "retrieval_uri": {
          "minLength": 1,
          "title": "Retrieval Uri",
          "type": "string"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "spdx_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spdx Id"
        }
      },
      "required": [
        "id",
        "retrieval_uri",
        "sha256",
        "admission",
        "authority_id"
      ],
      "title": "AssetSource",
      "type": "object"
    },
    "BoundRange": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "title": "Maximum",
          "type": "number"
        },
        "minimum": {
          "title": "Minimum",
          "type": "number"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "BoundRange",
      "type": "object"
    },
    "CalibrationEvidence": {
      "additionalProperties": false,
      "properties": {
        "applies_to_model_binding_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Applies To Model Binding Id",
          "type": "string"
        },
        "condition_domain": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$": {
              "type": "string"
            }
          },
          "title": "Condition Domain",
          "type": "object"
        },
        "fit_artifact_ref": {
          "minLength": 1,
          "title": "Fit Artifact Ref",
          "type": "string"
        },
        "fit_artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fit Artifact Sha256",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/CalibrationMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "source_artifact_ref": {
          "minLength": 1,
          "title": "Source Artifact Ref",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "split_rule_ref": {
          "minLength": 1,
          "title": "Split Rule Ref",
          "type": "string"
        },
        "split_rule_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Split Rule Sha256",
          "type": "string"
        },
        "supported_channel_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supported Channel Ids",
          "type": "array"
        },
        "validation_design": {
          "enum": [
            "within_trajectory",
            "cross_condition",
            "independent_facility_runs"
          ],
          "title": "Validation Design",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_artifact_ref",
        "source_sha256",
        "applies_to_model_binding_id",
        "supported_channel_ids",
        "condition_domain",
        "split_rule_ref",
        "split_rule_sha256",
        "fit_artifact_ref",
        "fit_artifact_sha256",
        "validation_design",
        "limitations"
      ],
      "title": "CalibrationEvidence",
      "type": "object"
    },
    "CalibrationMetric": {
      "additionalProperties": false,
      "properties": {
        "comparator": {
          "anyOf": [
            {
              "enum": [
                "le",
                "ge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparator"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "split": {
          "enum": [
            "fit",
            "guard",
            "temporal_holdout",
            "independent_test"
          ],
          "title": "Split",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "split"
      ],
      "title": "CalibrationMetric",
      "type": "object"
    },
    "ChannelSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$",
          "title": "Id",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value_type": {
          "enum": [
            "number",
            "integer",
            "boolean",
            "string",
            "vector3"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "value_type",
        "unit"
      ],
      "title": "ChannelSpec",
      "type": "object"
    },
    "ChannelValue": {
      "additionalProperties": false,
      "properties": {
        "channel_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$",
          "title": "Channel Id",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "channel_id",
        "value",
        "unit"
      ],
      "title": "ChannelValue",
      "type": "object"
    },
    "CollisionSpec": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "shape": {
          "default": "geometry",
          "enum": [
            "geometry",
            "box",
            "convex_hull",
            "none"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "title": "CollisionSpec",
      "type": "object"
    },
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "bound": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/BoundRange"
            }
          ],
          "title": "Bound"
        },
        "channel_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$",
          "title": "Channel Id",
          "type": "string"
        },
        "constrained_parameter_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constrained Parameter Name"
        },
        "enforcement": {
          "enum": [
            "reject",
            "terminate",
            "report"
          ],
          "title": "Enforcement",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lt",
            "le",
            "eq",
            "ge",
            "gt",
            "between"
          ],
          "title": "Operator",
          "type": "string"
        },
        "phase": {
          "enum": [
            "pre_action",
            "runtime",
            "post_action"
          ],
          "title": "Phase",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "verifier_binding_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Verifier Binding Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "phase",
        "channel_id",
        "operator",
        "bound",
        "unit",
        "enforcement",
        "verifier_binding_id"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "capability_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Capability Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "state_channels": {
          "items": {
            "$ref": "#/$defs/ChannelSpec"
          },
          "title": "State Channels",
          "type": "array"
        }
      },
      "required": [
        "id",
        "asset_id"
      ],
      "title": "Device",
      "type": "object"
    },
    "Facility": {
      "additionalProperties": false,
      "properties": {
        "authoring_basis": {
          "enum": [
            "exact",
            "derived",
            "representative"
          ],
          "title": "Authoring Basis",
          "type": "string"
        },
        "claim_boundary": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Boundary",
          "type": "array"
        },
        "frame": {
          "$ref": "#/$defs/FrameSpec"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1.0",
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "workstation_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Workstation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "workstation_ids",
        "authoring_basis",
        "claim_boundary"
      ],
      "title": "Facility",
      "type": "object"
    },
    "FacilityCapability": {
      "additionalProperties": false,
      "description": "A provider binding used by the v0.1 embodied facility IR.\n\nThis record is intentionally not the reusable scientific ``Capability``.\nIt connects an already selected operation to one device or embodied agent\ninside a compiled facility.",
      "properties": {
        "action_type": {
          "minLength": 1,
          "title": "Action Type",
          "type": "string"
        },
        "echoed_parameter_bindings": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Echoed Parameter Bindings",
          "type": "object"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "observation_channel_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$",
            "type": "string"
          },
          "title": "Observation Channel Ids",
          "type": "array"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/ParameterSpec"
          },
          "title": "Parameters",
          "type": "array"
        },
        "postcondition_constraint_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Postcondition Constraint Ids",
          "type": "array"
        },
        "precondition_constraint_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Precondition Constraint Ids",
          "type": "array"
        },
        "provider_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "reported_output_port_ids": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_./:-]{0,191}$": {
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            }
          },
          "title": "Reported Output Port Ids",
          "type": "object"
        }
      },
      "required": [
        "id",
        "provider_id",
        "action_type"
      ],
      "title": "FacilityCapability",
      "type": "object"
    },
    "FacilityProviderBinding": {
      "additionalProperties": false,
      "description": "Facility-side admission for one registry provider used by a composition.",
      "properties": {
        "adapter_links": {
          "items": {
            "$ref": "#/$defs/ProviderAdapterLink"
          },
          "minItems": 1,
          "title": "Adapter Links",
          "type": "array"
        },
        "endpoint_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Endpoint Id",
          "type": "string"
        },
        "evidence_classes": {
          "items": {
            "enum": [
              "simulator",
              "calibrated_twin",
              "shadow",
              "physical"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Classes",
          "type": "array"
        },
        "facility_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Facility Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Operation Id",
          "type": "string"
        },
        "policy_tags": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "title": "Policy Tags",
          "type": "array"
        },
        "provider_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "required_approval_ids": {
          "items": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$",
