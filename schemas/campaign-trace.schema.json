{
  "$defs": {
    "action": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "minLength": 1,
          "type": "string"
        },
        "actor_id": {
          "minLength": 1,
          "type": "string"
        },
        "evidence_class": {
          "enum": [
            "simulator",
            "calibrated_twin",
            "shadow",
            "physical"
          ]
        },
        "kind": {
          "enum": [
            "apply-thermal-program",
            "agitate-sample",
            "measure-plate-temperature",
            "measure-sample-temperature",
            "estimate-temperature-gradient",
            "measure-sample-mass",
            "measure-mixing-load",
            "estimate-reaction-progress",
            "measure-reaction-progress",
            "dispense_liquid",
            "dispense_solid",
            "material_transfer",
            "set_airflow",
            "set_glovebox_state",
            "transport",
            "wash_and_dry",
            "set_heater",
            "pick",
            "place",
            "wait",
            "observe",
            "stop"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "kind",
        "actor_id",
        "provider_id",
        "evidence_class",
        "parameters"
      ],
      "type": "object"
    },
    "constraint": {
      "additionalProperties": false,
      "properties": {
        "constraint_id": {
          "minLength": 1,
          "type": "string"
        },
        "limit": {
          "type": "object"
        },
        "measured_value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "phase": {
          "enum": [
            "pre_action",
            "runtime",
            "post_action"
          ]
        },
        "verifier": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "constraint_id",
        "phase",
        "passed",
        "measured_value",
        "limit",
        "verifier"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "enum": [
            "simulator",
            "calibrated_twin",
            "shadow",
            "physical"
          ]
        },
        "evidence_id": {
          "minLength": 1,
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "uri": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "uri",
        "sha256",
        "media_type",
        "role",
        "provider_id",
        "evidence_class"
      ],
      "type": "object"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "channels": {
          "items": {
            "$ref": "#/$defs/observation_channel"
          },
          "minItems": 1,
          "type": "array"
        },
        "evidence_class": {
          "enum": [
            "simulator",
            "calibrated_twin",
            "shadow",
            "physical"
          ]
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frame_id": {
          "minLength": 1,
          "type": "string"
        },
        "logical_time_s": {
          "minimum": 0,
          "type": "number"
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "logical_time_s",
        "provider_id",
        "evidence_class",
        "channels",
        "evidence_ids"
      ],
      "type": "object"
    },
    "observation_channel": {
      "additionalProperties": false,
      "properties": {
        "evidence_class": {
          "enum": [
            "simulator",
            "calibrated_twin",
            "shadow",
            "physical"
          ]
        },
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "origin": {
          "enum": [
            "runtime_sensor",
            "backend_state",
            "source_model",
            "physical_source"
          ]
        },
        "provider_id": {
          "minLength": 1,
          "type": "string"
        },
        "quality": {
          "enum": [
            "valid",
            "estimated",
            "degraded",
            "unavailable"
          ]
        },
        "unit": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "integer",
            "string",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "quality",
        "origin",
        "provider_id",
        "evidence_class"
      ],
      "type": "object"
    }
  },
  "$id": "https://dynamical.systems/schemas/dynamical/campaign-event-v0.1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "type": "null"
        }
      ]
    },
    "backend_revision": {
      "minLength": 1,
      "type": "string"
    },
    "campaign_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "campaign_id": {
      "minLength": 1,
      "type": "string"
    },
    "constraints": {
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "type": "array"
    },
    "event_id": {
      "minLength": 1,
      "type": "string"
    },
    "event_type": {
      "enum": [
        "campaign_start",
        "action",
        "observation",
        "campaign_end"
      ]
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "type": "array"
    },
    "ir_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "logical_time_s": {
      "minimum": 0,
      "type": "number"
    },
    "mode": {
      "enum": [
        "simulate",
        "replay"
      ]
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/observation"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "dynamical.campaign.v0.1"
    },
    "seed": {
      "minimum": 0,
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "source_trace_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "world_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "action",
    "backend_revision",
    "campaign_hash",
    "campaign_id",
    "constraints",
    "event_id",
    "event_type",
    "evidence",
    "ir_hash",
    "logical_time_s",
    "mode",
    "observation",
    "provenance",
    "run_id",
    "schema_version",
    "seed",
    "sequence",
    "source_trace_sha256",
    "world_hash"
  ],
  "title": "Dynamical Campaign TraceEvent v0.1",
  "type": "object"
}
